DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/sreg-cms
PAYLOAD_SECRET=YOUR_SECRET_HERE
MEDIA_DIR=media
FRONTEND_ORIGIN=http://localhost:4321
# Origin tambahan untuk CORS, pisah koma (opsional)
EXTRA_ORIGINS=
REBUILD_HOOK_URL=
PREVIEW_SECRET=
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_STORE_ID=
LOYVERSE_WEBHOOK_SECRET=

# Pengiriman: Biteship (tujuan Indonesia) dan FedEx (luar negeri, belum aktif)
BITESHIP_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Pembayaran: 'mock' (default di luar produksi) atau 'xendit'
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=
# 1 = buka POST /api/payments/mock/simulate di build produksi (hanya server dev/uji)
ALLOW_MOCK_SIMULATE=
# Xendit (PAYMENT_PROVIDER=xendit). Secret key: Settings > API keys (izin Money-in write).
# Callback token: Settings > Webhooks > Callback verification token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
ORDER_EXPIRY_HOURS=24
# 1 = tampilkan semua menu admin, termasuk yang disembunyikan karena frontend belum memakainya (hiddenInAdmin di payload.config.ts)
ADMIN_SHOW_ALL=

# Email (kosong = email hanya dicatat di log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sregcoffee.id
